<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/telegramotp/db" VERSION="2026100701" COMMENT="XMLDB file for local_telegramotp"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="local_telegramotp_requests" COMMENT="Stores Telegram Gateway OTP requests and verification logs">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="phone" TYPE="char" LENGTH="20" NOTNULL="true" SEQUENCE="false" COMMENT="Normalized E.164 phone number"/>
        <FIELD NAME="email" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false" COMMENT="Pre-validated email address"/>
        <FIELD NAME="request_id" TYPE="char" LENGTH="100" NOTNULL="true" SEQUENCE="false" COMMENT="Telegram Gateway request_id"/>
        <FIELD NAME="ip_address" TYPE="char" LENGTH="45" NOTNULL="true" SEQUENCE="false" COMMENT="Client IP for abuse prevention"/>
        <FIELD NAME="status" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="pending" SEQUENCE="false" COMMENT="Status: pending, verified, expired, failed"/>
        <FIELD NAME="attempts" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Failed verification attempts"/>
        <FIELD NAME="reg_data" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Serialized registration payload for bot webhook verification"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="phone_ix" UNIQUE="false" FIELDS="phone"/>
        <INDEX NAME="ip_ix" UNIQUE="false" FIELDS="ip_address, timecreated"/>
        <INDEX NAME="reqid_uix" UNIQUE="true" FIELDS="request_id"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
